vel":"OFFICIAL_POSTMORTEM","confidence":"HIGH","provenance":{"source_title":"GitHub Availability Report: June 2023; GitHub Availability Report: July 2023; GitHub Availability Report: August 2023","publisher":"GitHub","publication_date":"2023-07-12, 2023-08-09, 2023-09-13","evidence_type":"Official postmortems plus dataset-level inference","source_ref":"turn0search0; turn0search1; turn0search3"},"related_records":["D51-B71-R01","D51-B73-R01","D51-B74-R01","D51-B75-R01","D51-B77-R01"],"relationships":["derived_from","learned_from","related_to"]}

