{"record_id":"D55-B58-R03","dataset_id":"D55","dataset_version":"1.0","schema_version":"1.0","batch":"B58","topic":"Multi-Team Architecture Governance","subtopic":"Architecture Conflict Resolution","concept":"Conflicting architectural decisions require explicit escalation and evidence-based resolution rather than parallel undocumented interpretations.","knowledge_type":"GOVERNANCE_CONTROL","question":"How should architecture conflicts between teams be handled?","answer":"Conflicts should be identified, scoped, linked to affected decisions, evaluated against requirements and constraints, escalated to defined authority when necessary, and resolved through an explicit decision or recorded temporary disposition.","context":"Independent teams can make locally rational decisions that conflict at system boundaries.","objective":"Convert architectural conflicts into governed decisions.","requirements":["Detect conflicting decisions","Identify authoritative resolution path","Record final disposition"],"constraints":["Resolution authority must be defined"],"prerequisites":["Decision repository","Ownership model"],"dependencies":["Architecture review process"],"alternatives":["Local negotiation only"],"evidence":["Conflicting decision records","Impact analysis","Resolution decision"],"tradeoffs":["Formal conflict resolution adds process overhead but reduces hidden architectural inconsistency"],"decision":"Use explicit conflict-resolution governance for material architecture conflicts.","rationale":"Unresolved architectural conflict can create incompatible implementations and operational failure modes.","consequences":["Improved consistency","Need for escalation mechanisms"],"implementation_implications":["Link conflicting decisions","Prevent silent supersession","Record resolution authority"],"verification_method":"Create representative conflicting decisions and verify detection, escalation, and closure behavior.","outcome_learning":"Analyze recurring conflict categories for governance or boundary improvements.","code_applicability":"CODE_SUPPORTING","validation_status":"REQUIREMENT_SATISFIED","execution_status":"NOT_EXECUTED","evidence_level":"ENGINEERING_INFERENCE","confidence":"HIGH","provenance":{"source_type":"ENGINEERING_METHODOLOGY","source":"D55 Architecture Governance scope and quality specification","status":"INFERENTIAL","verification":"NOT_EXECUTED"},"related_records":["D55-B58-R01","D55-B58-R02"],"relationships":["ARCHITECTURE_CONFLICT_RESOLUTION"]}
