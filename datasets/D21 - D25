{"record_id":"D21-B74-001","batch_id":"D21-B74","domain":"performance","topic":"event_loop_starvation","knowledge_type":"async_performance","language":"Python","concept":"Blocking CPU work or blocking operations executed directly on an asyncio event-loop thread can prevent other tasks from making progress.","implementation_pattern":"Keep event-loop work short and cooperative and move appropriate blocking operations to a suitable executor or worker mechanism.","anti_pattern":"Execute long-running blocking work directly inside an async request handler or event-loop callback.","performance_effect":"Preserves responsiveness and prevents unrelated asynchronous tasks from experiencing avoidable latency.","verification_method":"Use event-loop diagnostics and controlled blocking workloads to measure callback delay and task latency.","execution_status":"NOT_EXECUTED","validation_status":"REVIEWED","evidence_level":"OFFICIAL_DOCUMENTATION_SUPPORTED","confidence":0.99,"version_range":"Python_3.11_PLUS","provenance":{"source_type":"official_documentation","source":"Python asyncio development documentation","source_version":"3.14.7"}}

