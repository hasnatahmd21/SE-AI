components to independent physical causes."],"version":"Technology-agnostic","dependencies":["Infrastructure topology","Failure-domain analysis"],"prerequisites":["Fault isolation"],"relationships":[{"relation":"supports","record_id":"D22-B95-002"}],"provenance":[{"source_type":"official_documentation","source":"NIST SP 800-160 Vol. 1 Rev. 1","basis":"Trustworthy systems engineering includes system elements, environments, lifecycle, and resilience."}],"evidence":{"evidence_level":"authoritative_guidance","claim_scope":"Physical dependency reliability"},"confidence":0.96,"validation":{"schema_status":"REVIEWED","semantic_status":"REVIEWED","execution_status":"NOT_EXECUTED","dedup_status":"REVIEWED"},"created_at":"2026-09-19","updated_at":"2026-09-19"}
