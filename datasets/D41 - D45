{"record_id":"D42-B79-R005","dataset":"D42","dataset_title":"Test Cases","batch":"B79","knowledge_type":"TEST_CASE","title":"Regression Evidence Traceability Test","objective":"Verify that each regression result can be traced to the change, requirement, defect, or compatibility behavior it is intended to protect.","precondition":"Regression tests and stable change or requirement identifiers exist.","input":"Regression test records and associated source/change metadata.","action":"Inspect mappings between tests, protected behaviors, changes, and results.","expected_result":"Each regression test has a traceable purpose and result context.","pass_criteria":"No authoritative regression result lacks sufficient provenance to explain what it protects.","failure_interpretation":"Untraceable regression evidence reduces its value for autonomous maintenance and learning.","implementation_relevance":"Supports durable knowledge extraction from repeated software changes.","code_applicability":"HIGH","security_considerations":"Security regression evidence must preserve sufficient provenance without exposing sensitive artifacts.","performance_considerations":"Traceability metadata should not require expensive runtime instrumentation during ordinary tests unless explicitly needed.","execution_status":"NOT_EXECUTED","verification_status":"SPECIFIED_NOT_EXECUTED","truth_class":"VERIFIED_FACT","provenance":"General regression-evidence traceability methodology."}

