fficial_documentation","publisher":"Python Software Foundation","title":"Python 3.11 Documentation","url":"https://docs.python.org/3.11/","reference_scope":"resource cleanup and object representation","version":"3.11","retrieval_date":null},"verification_status":"NOT_EXECUTED"}

