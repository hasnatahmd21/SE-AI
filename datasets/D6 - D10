{"record_id":"D09-B60-R02","dataset_id":"D09","batch_id":"B60","knowledge_type":"VERIFIED_FACT","language":"Python","language_version":"3.11+","topic":"Integrated Resilience","example_title":"Timeout Applied Only to Initial Connection","invalid_code":"import socket\n\nsock = socket.create_connection(('example.com', 443), timeout=5)\nsock.settimeout(None)\nsock.sendall(request)\nresponse = sock.recv(1024)","failure_type":"operation_timeout_gap","expected_error":"The connection can block indefinitely during send or recv after the socket timeout is disabled.","why_it_fails":"The code establishes a timeout for connection creation but explicitly removes the timeout before subsequent operations.","diagnostic_evidence":["create_connection receives timeout=5","settimeout(None) disables socket timeout","recv can therefore block indefinitely"],"likely_cause":"Confusing connection timeout with operation deadline.","corrected_code":"import socket\n\nsock = socket.create_connection(('example.com', 443), timeout=5)\nsock.settimeout(5)\nsock.sendall(request)\nresponse = sock.recv(1024)","preconditions":["Five seconds is an appropriate per-operation timeout."],"edge_cases":["slow server","partial response","large payload","overall request deadline"],"security_implications":"Unbounded network waits can consume resources and enable availability attacks.","performance_characteristics":"Timeouts bound waiting but do not guarantee total request duration unless an overall deadline is enforced.","testing_method":"Connect to a controlled endpoint that delays reads/writes and verify bounded behavior.","verification_method":"Verify every blocking network operation has an explicit timeout/deadline policy.","version_notes":"Python 3.11+ socket semantics.","relationships":[{"type":"related_to_dataset","target_dataset":"D18","target_scope":"networking"},{"type":"related_to_dataset","target_dataset":"D22","target_scope":"reliability"}],"provenance":{"source_type":"official_documentation","publisher":"Python Software Foundation","title":"socket — Low-level networking interface","url":"https://docs.python.org/3.11/library/socket.html","reference_scope":"socket timeouts","version":"3.11","retrieval_date":null},"verification_status":"NOT_EXECUTED"}

