aints and test duplicate insertion plus lookup behavior.","regression_test":"def test_unique_lookup_contract():\n    import sqlite3\n    conn = sqlite3.connect(':memory:')\n    conn.execute('CREATE TABLE users(id INTEGER PRIMARY KEY, email TEXT UNIQUE)')\n    conn.execute(\"INSERT INTO users(email) VALUES (?)\", ('alice@example.com',))\n    row = conn.execute('SELECT id FROM users WHERE email = ?', ('alice@example.com',)).fetchone()\n    assert row is not None","preconditions":["The application requires at most one logical entity for a lookup"],"edge_cases":["Legacy duplicates","Case-insensitive identifiers","Concurrent creation","Tenant-scoped uniqueness"],"security_implications":"Incorrect cardinality assumptions can cause authorization checks to inspect the wrong record or create ambiguous identity resolution.","performance_characteristics":"Uniqueness constraints typically provide an index-backed lookup path, but exact performance depends on the database engine and schema.","version_notes":"Uniqueness semantics can vary with collation and NULL handling across database engines.","relationships":["contrasts_with:D08","feeds:D36","feeds:D37","feeds:D40"],"provenance":{"source_type":"official_documentation","title":"Python 3.11 Documentation - sqlite3","publisher":"Python Software Foundation","url":"https://docs.python.org/3.11/library/sqlite3.html","version":"3.11","section":"Executing SQL statements and retrieving rows","retrieval_date":null,"provenance_note":"Reference target declared; source retrieval not performed in this generation."},"verification_status":"NOT_EXECUTED"}
