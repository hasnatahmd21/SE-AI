cific to Python 3.11.","relationships":[{"type":"related_to_dataset","target_dataset":"D19","target_scope":"cryptographic security"},{"type":"related_to_dataset","target_dataset":"D57","target_scope":"security lessons"}],"provenance":{"source_type":"official_documentation","publisher":"Python Software Foundation","title":"hashlib — Secure hashes and message digests","url":"https://docs.python.org/3.11/library/hashlib.html","reference_scope":"hash functions; password hashing requires additional design","version":"3.11","retrieval_date":null},"verification_status":"NOT_EXECUTED"}

