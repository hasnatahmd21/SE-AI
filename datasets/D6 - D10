ncurrency test must demonstrate that blocking work is not executed on the event-loop thread.","version_notes":"asyncio.to_thread is available in modern Python 3.x including Python 3.11.","relationships":[{"type":"related_to_dataset","target_dataset":"D04","target_scope":"async and concurrency semantics"},{"type":"related_to_dataset","target_dataset":"D21","target_scope":"performance engineering"}],"provenance":{"source_type":"official_documentation","publisher":"Python Software Foundation","title":"asyncio — Asynchronous I/O","url":"https://docs.python.org/3.11/library/asyncio.html","reference_scope":"event loop and to_thread","version":"3.11","retrieval_date":null},"verification_status":"NOT_EXECUTED"}

