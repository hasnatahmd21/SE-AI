nted without treating patterns as inherent security guarantees.","performance_implication":"Performance claims remain measured, estimated, inferred, or unknown rather than fabricated.","testing_guidance":"Final validation must include schema, semantic, version, provenance, deduplication, retrieval, security, performance, and verification checks.","verification_guidance":"A dataset-level lock requires all mandatory quality gates to be assessed and unresolved limitations recorded.","language":"English","version":"D13 v1.0","version_range":"D13 v1.0","dependencies":[],"prerequisites":["D13 B01-B99"],"related_records":["D13-DP-B01-0001","D13-DP-B90-0003","D13-DP-B100-0002"],"depends_on":["D13-DP-B90-0003"],"extends":[],"refines":[],"contrasts_with":[],"contradicts":[],"supersedes":[],"provenance":{"source_type":"dataset_scope_manifest","evidence_level":"STRUCTURAL"},"evidence_level":"FACT","confidence":"HIGH","validation_status":"NOT_EXECUTED"}

