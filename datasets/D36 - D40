l history and reproducible performance measurements.","related_records":["D39-B046","D39-B299"],"relationships":[{"type":"DEEPENS","target":"D39-B046"},{"type":"DEEPENS","target":"D39-B299"}]} {"record_id":"D39-B392","dataset_id":"D39","dataset_version":"1.0","batch":"B79","topic":"Performance Bisecting","knowledge_type":"PROCEDURE","objective":"Locate the introduction point of a performance regression through controlled version or configuration bisection.","requirements":["Each tested revision/configuration must be buildable or runnable","A stable performance test must exist","Regression criterion must be predefined"],"constraints":["Performance noise can produce false boundaries","Non-code environmental changes may contaminate results","Large commits can still require internal decomposition"],"procedure":["Define a measurable regression threshold","Run the benchmark on candidate revisions","Bisect the change space","Repeat boundary measurements","Inspect the identified change for causal evidence"],"verification_method":"Repeat the boundary test and confirm that neighboring revisions exhibit the expected performance distinction within measurement tolerance.","performance_claim_type":"MEASURED","validation_status":"STRUCTURAL","execution_status":"NOT_EXECUTED","provenance":"Version-control history and controlled benchmark protocol.","related_records":["D39-B391","D39-B297"],"relationships":[{"type":"DEEPENS","target":"D39-B391"},{"type":"RELATED_TO","target":"D39-B297"}]} {"record_id":"D39-B393","dataset_id":"D39","dataset_version":"1.0","batch":"B79","topic":"Performance Change-Point Detection","knowledge_type":"DIAGNOSTIC_PROCEDURE","objective":"Identify the time or version at which measured performance behavior changes materially when a direct regression boundary is not known.","requirements":["Time-series or versioned performance measurements","Stable metric definition","Change-point method appropriate to data characteristics"],"constraints":["Noise and workload