ferences when their lifetime contract is provably valid.","version_constraints":"C++ lifetime and reference semantics depend on the applicable C++ standard; compiler diagnostics and sanitizer support depend on the toolchain.","dependencies":[],"related_records":["D36-B025"],"derived_from":["D36-B025"],"provenance":{"source_type":"LANGUAGE_STANDARD","source_reference":"C++ reference and object lifetime semantics","evidence_level":"HIGH"},"confidence":"HIGH","truth_status":"VERIFIED_FACT","execution_status":"NOT_EXECUTED","validation_status":"ILLUSTRATIVE"}

