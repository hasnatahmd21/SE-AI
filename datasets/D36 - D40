 quota controls appropriate to the threat model and system capacity.","testing_method":"Controlled rate-limit boundary tests.","expected_test_result":"Requests within policy succeed; requests beyond policy are delayed, rejected, or otherwise controlled according to the defined contract.","verification_method":"Inspect effective enforcement and execute controlled threshold tests without uncontrolled load generation.","validation_status":"STRUCTURALLY_VALIDATED","execution_status":"NOT_EXECUTED","evidence_level":"VERIFIED_FACT","confidence":"HIGH","provenance":["OWASP API Security","OWASP Denial of Service Cheat Sheet"],"related_records":["D40-B090"],"relationships":{"requires":["D40-B090"],"verifies":["D40-B090"]}} {"record_id":"D40-B090","dataset_id":"D40","dataset_version":"1.0.0","schema_version":"1.0","batch":"B018","topic":"Security Problem → Remediation","subtopic":"Rate-limit verification","concept":"Rate-limit boundary test","knowledge_type":"TEST_CASE","objective":"Verify that a defined rate or quota policy is enforced consistently.","test_case":"Send controlled requests below, at, and above the configured policy threshold.","expected_test_result":"Requests behave according to the documented limit policy and protected resources remain available within the tested envelope.","testing_guidance":"Use isolated test infrastructure and modest controlled request volumes.","verification_method":"Compare observed request outcomes with the configured policy and inspect relevant telemetry.","validation_status":"ILLUSTRATIVE","execution_status":"NOT_EXECUTED","evidence_level":"VERIFIED_FACT","confidence":"HIGH","provenance":["OWASP API Security","OWASP Denial of Service Cheat Sheet"],"related_records":["D40-B089"],"relationships":{"tests":["D40-B089"],"verifies":["D40-B089"]}} {"record_id":"D40-B091","dataset_id":"D40","dataset_version":"1.0.0","schema_version":"1.0","batch":"B019","topic":"Security Problem → Remediation","subtopic":"CORS","concept":"Overly permissive cr