col, dependency APIs, and runtime.","dependencies":[],"related_records":["D36-B020","D36-B040","D36-B066"],"derived_from":["D36-B020","D36-B040","D36-B066"],"provenance":{"source_type":"RELIABILITY_ENGINEERING_PRINCIPLE","source_reference":"Failure classification, retry policy, fallback control, and fault recovery","evidence_level":"HIGH"},"confidence":"HIGH","truth_status":"VERIFIED_FACT","execution_status":"NOT_EXECUTED","validation_status":"ILLUSTRATIVE"}

