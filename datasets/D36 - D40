an undermine confidentiality and integrity guarantees of the protected connection.","verification_method":"Review client configuration, trust-store behavior, hostname verification, and applicable protocol settings.","validation_status":"STRUCTURALLY_VALIDATED","execution_status":"NOT_EXECUTED","evidence_level":"VERIFIED_FACT","confidence":"HIGH","provenance":["OWASP ASVS","NIST SP 800-52 Rev. 2"],"related_records":["D40-B096","D40-B098"],"relationships":{"refines":["D40-B096"],"verifies":["D40-B098"]}} {"record_id":"D40-B098","dataset_id":"D40","dataset_version":"1.0.0","schema_version":"1.0","batch":"B020","topic":"Security Problem → Remediation","subtopic":"Certificate validation testing","concept":"TLS certificate-validation regression test","knowledge_type":"TEST_CASE","objective":"Verify that the client validates the server certificate according to the intended trust policy.","test_case":"Connect to a controlled endpoint using a valid trusted certificate and then a controlled endpoint with an invalid or untrusted certificate.","expected_test_result":"The valid endpoint succeeds and the invalid/untrusted endpoint is rejected.","testing_guidance":"Use test certificates and an isolated environment; never disable verification merely to make the test pass.","verification_method":"Inspect connection outcomes and client verification configuration.","validation_status":"ILLUSTRATIVE","execution_status":"NOT_EXECUTED","evidence_level":"VERIFIED_FACT","confidence":"HIGH","provenance":["OWASP ASVS","NIST SP 800-52 Rev. 2"],"related_records":["D40-B096","D40-B097"],"relationships":{"tests":["D40-B096"],"verifies":["D40-B097"]}} {"record_id":"D40-B099","dataset_id":"D40","dataset_version":"1.0.0","schema_version":"1.0","batch":"B020","topic":"Security Problem → Remediation","subtopic":"Remediation evidence","concept":"Security remediation evidence package","knowledge_type":"PATTERN","objective":"Preserve enough evidence to demonstrate what security problem existed, what changed, and what evidence supports closure.","requirements":["Original finding","Affected component","Root-cause evidence","Remediation change","Test evidence","Deployment evidence","Residual limitations"],"expected_behavior":"An independent reviewer can reconstruct the remediation decision without relying on undocumented assumptions.","verification_method":"Audit evidence completeness and map each closure claim to supporting evidence.","validation_status":"STRUCTURALLY_VALIDATED","execution_status":"NOT_EXECUTED","evidence_level":"VERIFIED_FACT","confidence":"HIGH","provenance":["NIST SP 800-40 Rev. 4","OWASP ASVS"],"related_records":["D40-B005","D40-B100"],"relationships":{"extends":["D40-B005"],"requires":["D40-B100"]}} {"record_id":"D40-B100","dataset_id":"D40","dataset_version":"1.0.0","schema_version":"1.0","batch":"B020","topic":"Security Problem → Remediation","subtopic":"Remediation closure","concept":"Independent security remediation review","knowledge_type":"VERIFICATION_RULE","objective":"Ensure remediation closure is based on evidence rather than solely on the implementer's assertion.","requirements":["Review original finding","Review root cause","Review corrective change","Review security tests","Review deployment state","Record unresolved limitations"],"expected_behavior":"Closure status reflects the actual available evidence and remains UNKNOWN or PARTIALLY_VERIFIED where required evidence is missing.","verification_method":"Independent evidence review with traceability from finding to observed post-remediation state.","limitations":["Review quality depends on the completeness and trustworthiness of the available evidence sources."],"validation_status":"STRUCTURALLY_VALIDATED","execution_status":"NOT_EXECUTED","evidence_level":"VERIFIED_FACT","confidence":"HIGH","provenance":["D40 authoritative dataset methodology","NIST SP 800-40 Rev. 4","OWASP ASVS"],"related_records":["D40-B099","D40-B050"],"relationships":{"verifies":["D40-B099","D40-B050"],"extend