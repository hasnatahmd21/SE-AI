"dataset_id":"D39","dataset_version":"1.0","batch":"B47","knowledge_type":"PERFORMANCE_CASE","topic":"Concurrency Performance","subtopic":"Cancellation Storm","objective":"Prevent large numbers of simultaneous cancellation events from creating secondary CPU and synchronization spikes.","requirements":["Cancellation must remain observable and semantically correct","Cleanup handlers must be idempotent"],"constraints":["Cancellation is required for bounded latency and shutdown correctness","Suppressing cancellation can leak resources"],"implementation_pattern":"Use structured cancellation propagation and avoid redundant cancellation signals or expensive per-task cleanup where aggregation is possible.","failure_mode":"A large workload is cancelled and cleanup itself creates a CPU or scheduling spike.","root_cause":"Thousands of independent tasks perform duplicated cancellation and cleanup work.","optimization":"Aggregate cancellation, bound task count, and make cleanup proportional to actual resources held.","verification_method":"Measure cancellation latency, cleanup CPU, active-task count, resource release time, and residual work.","performance_claim_type":"INFERRED","validation_status":"DOCUMENTED_PATTERN","execution_status":"NOT_EXECUTED","provenance_basis":["Async runtime cancellation documentation","Concurrency literature"],"related_records":["D39-B023","D39-B111","D39-B233"],"relationships":["PRESERVES_CANCELLATION_SEMANTICS","REQUIRES_CLEANUP_CORRECTNESS"]} {"record_id":"D39-B235","dataset_id":"D39","dataset_version":"1.0","batch":"B47","knowledge_type":"PERFORMANCE_CASE","topic":"Scheduler Behavior","subtopic":"Scheduler Fairness","objective":"Balance throughput and latency by preventing one class of work from monopolizing available execution capacity.","requirements":["Work classes and latency objectives must be defined","Scheduler supports relevant priority or fairness controls"],"constraints":["Strict fairness can reduce throughput","Priority changes can create starvation or inversion"],"implementation_pattern":"Use bounded queues, explicit work classes, or scheduler-supported fairness mechanisms when profiling shows starvation or latency interference.","failure_mode":"Large or CPU-heavy tasks delay latency-sensitive work.","root_cause":"Scheduling policy allows dominant workloads to consume disproportionate execution capacity.","optimization":"Partition or prioritize work according to explicit latency and throughput requirements.","verification_method":"Measure per-class latency, queue wait time, throughput, starvation intervals, and CPU utilization.","performance_claim_type":"MEASURED_REQUIRED","validation_status":"METHODOLOGY_RULE","execution_status":"NOT_EXECUTED","provenance_basis":["Operating-system scheduling documentation","Concurrency scheduling literature"],"related_records":["D39-B023","D39-B219","D39-B233"],"relationships":["LATENCY_THROUGHPUT_TRADEOFF","WORKLOAD_POLICY_DEPENDENT"]} {"record_id":"D39-B236","dataset_id":"D39","dataset_version":"1.0","batch":"B48","knowledge_type":"PERFORMANCE_CASE","topic":"Synchronization Performance","subtopic":"Atomic Versus Lock Tradeoff","objective":"Select synchronization mechanisms based on contention, critical-section size, and correctness requirements.","requirements":["Shared-state invariants must be explicitly defined","Chosen atomic or lock semantics must be supported by the target language/runtime"],"constraints":["Atomics are not universally faster","Complex multi-variable invariants may require locks or transactional mechanisms"],"implementation_pattern":"Replace lock-based synchronization with atomics only when the state transition is safely representable and profiling demonstrates meaningful contention cost.","failure_mode":"A lock is replaced with atomics and performance or correctness worsens.","root_cause":"The optimization assumes atomics are cheaper without accounting for contention, retries, memory ordering, or multi-variable consistency.","optimization":"Choose synchronization primitives from measured contention and required invariants rather than primitive preference.","verification_method":"Run concurrency tests and measure contention, retries, CPU time, latency, and correctness.","performance_claim_type":"MEASURED_REQUIRED","validation_status":"METHODOLOGY_RULE","execution_status":"NOT_EXECUTED","provenance_basis":["Language memory-model documentation","Concurrency literature"],"related_records":["D39-B020","D39-B044","D39-B121"],"relationships":["CORRECTNESS_FIRST","CONTENTIOUS_WORKLOAD_DEPENDENT"]} {"record_id":"D39-B237","dataset_id":"D39","dataset_version":"1.0","batch":"B48","knowledge_type":"PERFORMANCE_CASE","topic":"CPU Cache Performance","subtopic":"False Sharing","objective":"Reduce cache-coherence traffic caused by independent threads modifying data located on the same cache line.","requirements":["Profiling or hardware evidence must indicate false sharing","Data fields must remain semantically independent"],"constraints":["Padding changes memory footprint","Cache-line size can vary across architectures"],"implementation_pattern":"Separate frequently modified per-thread or per-core data when profiling demonstrates coherence traffic caused by false sharing.","failure_mode":"Independent counters or state variables scale poorly despite low logical contention.","root_cause":"Independent writable variables share cache lines and trigger repeated coherence invalidation.","optimization":"Use suitable alignment, padding, or per-thread structures where supported and justified.","verification_method":"Measure scaling, cache-coherence metrics where available, CPU utilization, and memory footprint across target hardware.","performance_claim_type":"MEASURED_REQUIRED","validation_status":"DOCUMENTED_PATTERN","execution_status":"NOT_EXECUTED","provenance_basis":["Processor architecture documentation","Concurrency performance literature"],"related_records":["D39-B044","D39-B231","D39-B232"],"relationships":["HARDWARE_DEPENDENT","MEMORY_FOOTPRINT_TRADEOFF"]} {"record_id":"D39-B238","dataset_id":"D39","dataset_version":"1.0","batch":"B48","knowledge_type":"PERFORMANCE_CASE","topic":"Memory Architecture","subtopic":"NUMA Locality","objective":"Reduce remote-memory access costs on NUMA systems for workloads with strong locality.","requirements":["Deployment hardware must expose NUMA characteristics","Workload must have meaningful CPU and memory locality"],"constraints":["NUMA optimization can reduce portability","Manual affinity can conflict with scheduler behavior"],"implementation_pattern":"Place frequently accessed data near the execution resources that use it when profiling demonstrates material remote-memory cost.","failure_mode":"Multi-socket workloads show poor scaling despite adequate aggregate CPU and memory capacity.","root_cause":"Threads repeatedly access memory allocated on remote NUMA nodes.","optimization":"Use NUMA-aware allocation, scheduling, or partitioning where supported and justified by measurements.","verification_method":"Measure local versus remote memory access, latency, throughput, CPU utilization, and scaling across sockets.","performance_claim_type":"MEASURED_REQUIRED","validation_status":"DOCUMENTED_PATTERN","execution_status":"NOT_EXECUTED","provenance_basis":["Operating-system NUMA documentation","Processor architecture documentation"],"related_records":["D39-B044","D39-B237","D39-B049"],"relationships":["HARDWARE_TOPOLOGY_DEPENDENT","REQUIRES_PROFILE_EVIDENCE"]} {"record_id":"D39-B239","dataset_id":"D39","dataset_version":"1.0","batch":"B48","knowledge_type":"PERFORMANCE_CASE","topic":"Memory Allocation","subtopic":"Allocator Contention","objective":"Reduce allocator synchronization or fragmentation overhead in highly concurrent allocation-heavy workloads.","requirements":["Profiling must identify allocation as a material cost","Alternative allocator or allocation strategy must preserve runtime semantics"],"constraints":["Allocator behavior is run