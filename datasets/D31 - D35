{"record_id":"D32-B44-R003","dataset_id":"D32","batch_id":"B44","topic":"sql.Rows lifecycle and resource release","knowledge_type":"INVALID_IMPLEMENTATION","code_applicability":"CODE_HEAVY","language":"Go","language_version":"Go 1.26","objective":"Prevent database resource leaks caused by failing to close or fully consume query result resources.","requirements":["Check query errors","Close rows when the caller does not consume them fully","Handle Scan and iteration errors"],"constraints":["Driver-specific resource behavior may vary","Rows lifecycle must be treated as a resource boundary"],"inputs":["*sql.Rows"],"outputs":["properly released query resources"],"source_code":"rows, err := db.QueryContext(ctx, query)\nif err != nil {\n    return err\n}\nfor rows.Next() {\n    // process rows\n}\nreturn rows.Err()","incorrect_code":"rows, err := db.QueryContext(ctx, query)\nif err != nil { return err }\nfor rows.Next() { process(rows) }\nreturn nil","corrected_code":"rows, err := db.QueryContext(ctx, query)\nif err != nil { return err }\ndefer rows.Close()\nfor rows.Next() { process(rows) }\nreturn rows.Err()","failure_mode":"Result resources may remain open when iteration terminates early or lifecycle assumptions differ.","root_cause":"Resource ownership is not made explicit.","testing":["Early-return test","Scan-error test","Repeated query load test"],"verification":"Verify resources are released on success, iteration error, and early-return paths.","execution_status":"ILLUSTRATIVE","validation_status":"STRUCTURALLY_VALIDATED_NOT_EXECUTED","evidence_level":"DOCUMENTED","confidence":0.97,"provenance":[{"source_locator":"pkg.go.dev/database/sql","source_type":"official_go_package_documentation","claim":"database/sql defines Rows lifecycle and database resource behavior."}],"relationships":[{"type":"fails_as","target":"D32-B44-R004"},{"type":"corrected_by","target":"D32-B44-R004"},{"type":"tests","target":"D32-B44-R005"}]}

{"record_id":"D32-B44-R004","dataset_id":"D32","batch_id":"B44","topic":"Transaction commit and rollback lifecycle","knowledge_type":"IMPLEMENTATION","code_applicability":"CODE_HEAVY","language":"Go","language_version":"Go 1.26","objective":"Implement database transactions with explicit rollback-on-failure and commit-on-success behavior.","requirements":["Begin transaction","Use transaction handle for transactional statements","Rollback on failure","Commit only after all required operations succeed"],"constraints":["Not every database operation should be wrapped in a transaction","Transaction duration affects locking/resource usage","Commit failure must be handled"],"inputs":["context","database handle","transaction operations"],"outputs":["committed transaction or error with rollback attempt"],"source_code":"tx, err := db.BeginTx(ctx, nil)\nif err != nil { return err }\ndefer tx.Rollback()\n\nif _, err := tx.ExecContext(ctx, statement); err != nil {\n    return err\n}\n\nif err := tx.Commit(); err != nil {\n    return err\n}\nreturn nil","correct_code":"Use a deferred rollback as a failure safety net while treating successful Commit as the transaction completion point.","incorrect_code":"tx, _ := db.Begin()\ntx.Exec(statement)\nreturn nil","failure_mode":"Errors can be ignored and transaction completion becomes ambiguous.","root_cause":"Transaction lifecycle is not modeled as a success/failure state machine.","testing":["Commit path","Statement failure path","Rollback path","Commit failure handling"],"verification":"Verify atomicity semantics against the selected database and driver, including failure paths.","execution_status":"ILLUSTRATIVE","validation_status":"STRUCTURALLY_VALIDATED_NOT_EXECUTED","evidence_level":"DOCUMENTED","confidence":0.98,"provenance":[{"source_locator":"pkg.go.dev/database/sql","source_type":"official_go_package_documentation","claim":"database/sql exposes transaction APIs including BeginTx, Commit, and Rollback."}],"relationships":[{"type