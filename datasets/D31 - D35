{"record_id":"D32-B44-R002","dataset_id":"D32","topic":"Go database/sql","subtopic":"Context Cancellation","concept":"QueryContext and ExecContext","knowledge_type":"IMPLEMENTATION","language":"Go","version":"Go 1.26","objective":"Propagate request deadlines and cancellation into database operations.","requirements":["Accept context from the request boundary","Use context-aware database APIs","Handle cancellation errors appropriately"],"input":"context.Context and database query","output":"Cancelable database operation","expected_behavior":"Cancellation or deadline propagation reaches the database operation when supported by the driver.","failure_mode":"context.Background is created deep inside request handling, disconnecting database work from request lifecycle.","root_cause":"Context ownership is inverted.","corrected_approach":"Accept context at the API boundary and pass it through to QueryContext, ExecContext, BeginTx, or equivalent operations.","testing":"Test cancellation and deadline behavior with a database/driver that supports the operation.","verification":"Verify cancellation behavior rather than assuming every driver reacts identically.","security_implication":"Cancellation can help bound resource consumption and reduce abandoned operations.","performance_implication":"Deadlines prevent work from continuing indefinitely after the caller has stopped waiting.","execution_status":"NOT_EXECUTED","validation_status":"GENERATED","code_applicability":"CODE_HEAVY","source_code":"rows, err := db.Query("SELECT id FROM users")","corrected_code":"rows, err := db.QueryContext(ctx, "SELECT id FROM users")\nif err != nil { return err }\ndefer rows.Close()","test_code":"// Test with a controlled timeout and verify cancellation handling.","provenance":{"source_type":"official_documentation","source_locator":"pkg.go.dev/database/sql","evidence_level":"HIGH","confidence":"HIGH"},"relationships":["corrected_by","implements","tests","verifies"]}
{"record_id":"D32-B44-R003","dataset_id":"D32","topic":"Go database/sql","subtopic":"Rows and Resource Lifecycle","concept":"Rows.Close and iteration errors","knowledge_type":"DEBUGGING","language":"Go","version":"Go 1.26","objective":"Prevent database resource leaks and detect errors that occur during row iteration.","requirements":["Close rows","Check rows.Err after iteration","Handle Scan errors"],"input":"database/sql Rows","output":"Complete and validated row-processing lifecycle","expected_behavior":"Rows are released and iteration errors are surfaced to the caller.","failure_mode":"Rows.Close or rows.Err is omitted and resource or driver errors remain hidden.","root_cause":"The row lifecycle is treated as successful once Scan completes.","corrected_approach":"Defer rows.Close after successful query creation, iterate with Scan, then inspect rows.Err.","testing":"Test query failure, scan failure, early return, and iteration failure paths.","verification":"Verify that all resource and iteration errors reach the intended error boundary.","security_implication":"Unreleased database resources can become a denial-of-service vector under sustained load.","performance_implication":"Resource leaks can exhaust the connection pool and increase latency.","execution_status":"NOT_EXECUTED","validation_status":"GENERATED","code_applicability":"CODE_HEAVY","source_code":"rows, err := db.QueryContext(ctx, query)\nif err != nil { return err }\nfor rows.Next() { / Scan */ }","corrected_code":"rows, err := db.QueryContext(ctx, query)\nif err != nil { return err }\ndefer rows.Close()\nfor rows.Next() {\n    if err := rows.Scan(&id); err != nil { return err }\n}\nif err := rows.Err(); err != nil { return err }","test_code":"// Test early return and iterator-error paths using a database test harness.","provenance":{"source_type":"official_documentation","source_locator":"pkg.go.dev/database/sql","evidence_level":"HIGH","confidence":"HIGH"},"relationships":["corrected_by","tests","ve