{"record_id":"D32-B47-R002","dataset_id":"D32","topic":"Go Security","subtopic":"TLS","concept":"TLS client configuration","knowledge_type":"SECURITY","language":"Go","version":"Go 1.26","objective":"Prevent insecure HTTP client configuration from disabling certificate or hostname verification without an explicit controlled reason.","requirements":["Use secure TLS defaults","Validate certificates and hostnames","Treat InsecureSkipVerify as exceptional and controlled"],"input":"Outbound HTTPS client configuration","output":"Authenticated encrypted transport","expected_behavior":"TLS verification remains enabled for normal production communication.","failure_mode":"tls.Config{InsecureSkipVerify:true} is used as a general workaround for certificate errors.","root_cause":"Certificate trust problems are bypassed instead of diagnosed.","corrected_approach":"Fix certificate/trust configuration or use an explicitly controlled trust store rather than disabling verification.","testing":"Test valid certificates, invalid certificates, hostname mismatch, and trusted private CA scenarios where applicable.","verification":"Verify that production configuration does not silently disable verification.","security_implication":"Disabling certificate verification can enable man-in-the-middle attacks.","performance_implication":"TLS configuration affects connection setup and reuse; security must not be traded for arbitrary speed.","execution_status":"NOT_EXECUTED","validation_status":"GENERATED","code_applicability":"CODE_HEAVY","source_code":"tlsConfig := &tls.Config{InsecureSkipVerify: true}","corrected_code":"tlsConfig := &tls.Config{\n    MinVersion: tls.VersionTLS12,\n}","test_code":"// Test certificate validation using controlled test certificates.","provenance":{"source_type":"official_documentation","source_locator":"pkg.go.dev/crypto/tls","evidence_level":"HIGH","confidence":"HIGH"},"relationships":["corrected_by","protects","tests","verifies"]}
{"record_id":"D32-B47-R003","dataset_id":"D32","topic":"Go Security","subtopic":"Path Handling","concept":"Path traversal resistance","knowledge_type":"SECURITY","language":"Go","version":"Go 1.26","objective":"Prevent untrusted path components from escaping an intended filesystem boundary.","requirements":["Treat paths from untrusted input as hostile","Define the permitted root","Validate resolved paths against the intended boundary","Consider platform-specific path semantics"],"input":"Untrusted path component","output":"Bounded filesystem operation","expected_behavior":"An attacker-controlled path cannot cause access outside the authorized directory.","failure_mode":"User input is concatenated directly into filesystem paths.","root_cause":"String concatenation is mistaken for secure path resolution.","corrected_approach":"Resolve and validate the resulting path against a trusted root using platform-appropriate filesystem APIs and policy.","testing":"Test traversal sequences, absolute paths, separators, symlink scenarios, and platform-specific cases.","verification":"Verify that every tested malicious path remains within the authorized boundary.","security_implication":"Path traversal can expose or overwrite unauthorized files.","performance_implication":"Path validation adds small overhead that is normally justified at security boundaries.","execution_status":"NOT_EXECUTED","validation_status":"GENERATED","code_applicability":"CODE_HEAVY","source_code":"path := filepath.Join(root, userPath)\nreturn os.ReadFile(path)","corrected_code":"// Validate the resolved path against an explicitly trusted root before access.\n// Exact implementation must account for symlinks and platform semantics.","test_code":"// Security tests must include traversal, absolute, symlink, and separator cases.","provenance":{"source_type":"official_documentation","source_locator":"pkg.go.dev/path/filepath;pkg.go.dev/os","evidence_level":"HIGH","confidence":"HIGH"},"relationships":["protects",