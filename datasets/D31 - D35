{"record_id":"D32-B43-R002","dataset_id":"D32","batch_id":"B43","topic":"Garbage collection aware optimization","knowledge_type":"PERFORMANCE","code_applicability":"CODE_RELEVANT","language":"Go","language_version":"Go 1.26","objective":"Reduce unnecessary allocation pressure when profiling demonstrates that garbage collection or allocation contributes materially to the workload.","requirements":["Profile before optimization","Identify allocation source","Preserve correctness and maintainability","Measure after optimization"],"constraints":["Lower allocations are not automatically better if complexity increases disproportionately","Runtime behavior varies with workload","GC tuning cannot replace inefficient algorithms"],"inputs":["allocation profile","benchmark","source code"],"outputs":["candidate optimization","measured comparison"],"source_code":"// Optimization should target a measured allocation source.\n// Prefer simpler lifetime/ownership changes before global runtime tuning.","correct_code":"Use profiling evidence to reduce unnecessary allocations at the actual hot path, then rerun the same workload.","incorrect_code":"Add arbitrary GC configuration changes before identifying the allocation source.","failure_mode":"Runtime tuning masks an application-level allocation problem.","root_cause":"Optimization is performed without causal evidence.","testing":["Allocation benchmark","Heap profile","Functional regression tests"],"verification":"The optimization requires measured evidence showing the intended effect without functional regression.","execution_status":"ILLUSTRATIVE","validation_status":"STRUCTURALLY_VALIDATED_NOT_EXECUTED","evidence_level":"METHODOLOGY","confidence":0.97,"provenance":[{"source_locator":"go.dev/doc/diagnostics","source_type":"official_go_documentation","claim":"Heap profiles provide allocation-related diagnostic information."}],"relationships":[{"type":"depends_on","target":"D32-B41-R001"},{"type":"related_to","target":"D32-B42-R002"}]}

{"record_id":"D32-B43-R003","dataset_id":"D32","batch_id":"B43","topic":"sync.Pool tradeoffs","knowledge_type":"DESIGN","code_applicability":"CODE_RELEVANT","language":"Go","language_version":"Go 1.26","objective":"Use sync.Pool only when temporary object reuse is supported by measured workload characteristics.","requirements":["Understand that pooled objects are temporary","Reset objects before reuse","Measure allocation/GC impact","Avoid using Pool as general ownership storage"],"constraints":["Pool contents may disappear","Pool is not a durable cache","Object reuse can introduce stale-state bugs"],"inputs":["temporary allocation hotspot","object lifecycle"],"outputs":["pool-based design or justified rejection"],"source_code":"var buffers = sync.Pool{\n    New: func() any { return new(bytes.Buffer) },\n}\n\nfunc useBuffer() {\n    b := buffers.Get().(*bytes.Buffer)\n    b.Reset()\n    defer buffers.Put(b)\n    // use b\n}","correct_code":"Reset pooled objects and return them only when their temporary reuse is safe and measured to be beneficial.","incorrect_code":"Use sync.Pool as a permanent object cache whose contents must always be available.","failure_mode":"Program correctness becomes dependent on Pool retention.","root_cause":"sync.Pool is intended for temporary reusable objects rather than durable storage.","testing":["Concurrent tests","Stale-state tests","Allocation benchmark","Load test"],"verification":"Verify that program correctness does not depend on objects remaining in the pool.","execution_status":"ILLUSTRATIVE","validation_status":"STRUCTURALLY_VALIDATED_NOT_EXECUTED","evidence_level":"DOCUMENTED","confidence":0.97,"provenance":[{"source_locator":"pkg.go.dev/sync","source_type":"official_go_package_documentation","claim":"sync.Pool provides a temporary pool of reusable objects and may remove pooled items."}],"relationships":[{"type":"contrasts_with","target":"D32-B43-R002"},{"type":"requires","target":"D32-B43-R005"}]}

