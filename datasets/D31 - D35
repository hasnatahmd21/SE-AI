{"record_id":"D32-B45-R004","dataset_id":"D32","batch_id":"B45","topic":"JSON resource limits and defensive decoding","knowledge_type":"SECURITY","code_applicability":"CODE_HEAVY","language":"Go","language_version":"Go 1.26","objective":"Prevent unbounded request-body processing from becoming a resource-exhaustion risk.","requirements":["Apply request size limits where appropriate","Validate decoded structures","Reject malformed or semantically invalid input","Avoid trusting client-provided structure"],"constraints":["Limits must reflect legitimate payload sizes","Different endpoints may require different limits"],"inputs":["HTTP request body","JSON decoder"],"outputs":["bounded parsing operation"],"source_code":"body := http.MaxBytesReader(w, r.Body, 1<<20)\ndec := json.NewDecoder(body)\nvar req Request\nif err := dec.Decode(&req); err != nil {\n    http.Error(w, "invalid request", http.StatusBadRequest)\n    return\n}","correct_code":"Bound the input stream before decoding when endpoint payload size is expected to be limited.","incorrect_code":"json.NewDecoder(r.Body).Decode(&req)","failure_mode":"An endpoint may process an unexpectedly large request body before application-level validation.","root_cause":"Resource limits are omitted from the input boundary.","testing":["Oversized body test","Malformed JSON test","Valid maximum-size test"],"verification":"Verify rejection behavior at and beyond the documented payload boundary.","execution_status":"ILLUSTRATIVE","validation_status":"STRUCTURALLY_VALIDATED_NOT_EXECUTED","evidence_level":"SECURITY_METHODOLOGY","confidence":0.98,"provenance":[{"source_locator":"pkg.go.dev/net/http","source_type":"official_go_package_documentation","claim":"net/http provides MaxBytesReader for limiting the size of request bodies."}],"relationships":[{"type":"protects","target":"D32-B45-R001"},{"type":"related_to","target":"D32-B39-R005"}]}

