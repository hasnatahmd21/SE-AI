[{"type":"extends","record_id":"D50-B61-R002"},{"type":"related_to","record_id":"D50-B64-R005"}]} {"record_id":"D50-B72-R001","dataset_id":"D50","topic":"Successful Projects","subtopic":"Decision Learning","concept":"Success decision reconstruction","knowledge_type":"decision_evidence","objective":"Capture the decision path that preceded a successful project outcome.","requirements":["Record relevant alternatives considered.","Record decision criteria.","Record evidence available at decision time.","Record resulting decision."],"constraints":["Later success must not be projected backward as if it were known before the decision.","Post-outcome information must be distinguished from decision-time information."],"input":"Decision records, alternatives, evidence available at decision time, outcome evidence.","output":"Decision-to-outcome trace.","expected_behavior":"The system can reconstruct what was known, decided, and observed without hindsight contamination.","failure_mode":"Successful outcome is used to falsely validate every decision made before it.","root_cause":"Decision-time and post-outcome evidence were merged.","testing_method":"Reconstruct a historical decision using only evidence available at that time.","test_input":"Timestamped decision evidence and later outcome.","expected_test_result":"Decision reconstruction excludes later evidence from the original decision state.","verification_method":"Temporal provenance audit.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 12207:2017","ISO/IEC/IEEE 29119"],"relationships":[{"type":"extends","record_id":"D50-B70-R005"},{"type":"related_to","record_id":"D50-B72-R002"}]} {"record_id":"D50-B72-R002","dataset_id":"D50","topic":"Successful Projects","subtopic":"Decision Learning","concept":"Decision rationale preservation","knowledge_type":"decision_evidence","objective":"Preserve why a successful project decision was made rather than retaining only the final choice.","requirements":["Record objective.","Record constraints.","Record alternatives.","Record selection rationale.","Record uncertainty at decision time."],"constraints":["Rationale must reflect the actual decision context, not a retrospective justification."],"input":"Decision event and available decision artifacts.","output":"Structured decision-rationale record.","expected_behavior":"A future engineer can understand the constraints and evidence that shaped the decision.","failure_mode":"Future reuse copies the decision without understanding its original assumptions.","root_cause":"Only the selected implementation was retained.","testing_method":"Attempt to reconstruct the decision using the stored rationale.","test_input":"Decision record with alternatives and constraints.","expected_test_result":"The selected decision is explainable from contemporaneous evidence.","verification_method":"Compare rationale with timestamped source artifacts.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 12207:2017","ISO/IEC/IEEE 29119"],"relationships":[{"type":"refines","record_id":"D50-B72-R001"},{"type":"related_to","record_id":"D50-B73-R001"}]} {"record_id":"D50-B72-R003","dataset_id":"D50","topic":"Successful Projects","subtopic":"Decision Learning","concept":"Decision outcome linkage","knowledge_type":"outcome_learning","objective":"Link a project decision to measurable or observable downstream outcomes without assuming causation beyond available evidence.","requirements":["Identify decision event.","Identify relevant outcome.","Record temporal relationship.","Record attribution evidence and uncertainty."],"constraints":["Temporal sequence does not by itself prove causal effect."],"input":"Decision event, subsequent outcome, and attribution evidence.","output":"Bounded decision-to-outcome relationship.","expected_behavior":"The record distinguishes observed sequence from supported causal interpretation.","failure_mode":"Any favorable outcome following a decision is attributed to that decision.","root_cause":"Correlation treated as causation.","testing_method":"Review decision and outcome evidence with alternative explanations.","test_input":"Decision record and subsequent outcome measurements.","expected_test_result":"Attribution is classified according to available evidence.","verification_method":"Trace timing, mechanism, alternatives, and evidence quality.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["Established causal-inference methodology","ISO/IEC/IEEE 29119"],"relationships":[{"type":"extends","record_id":"D50-B72-R001"},{"type":"related_to","record_id":"D50-B63-R002"}]} {"record_id":"D50-B72-R004","dataset_id":"D50","topic":"Successful Projects","subtopic":"Decision Learning","concept":"Decision reversal evidence","knowledge_type":"adaptive_engineering_evidence","objective":"Capture conditions under which a previously successful decision should no longer be retained.","requirements":["Identify original assumptions.","Identify changed conditions.","Define reversal triggers.","Record evidence supporting the changed decision."],"constraints":["A successful historical decision is not permanently valid under all future conditions."],"input":"Historical decision, current evidence, changed conditions.","output":"Decision-validity boundary and reversal criteria.","expected_behavior":"Changed assumptions can invalidate or constrain reuse of the original decision without deleting historical evidence.","failure_mode":"Historical success creates resistance to evidence-based revision.","root_cause":"Success was treated as permanent correctness.","testing_method":"Introduce a declared invalidating condition and evaluate decision status.","test_input":"Original decision plus changed prerequisite.","expected_test_result":"Decision is marked for review or reversal according to the defined trigger.","verification_method":"Compare current conditions against recorded assumptions and reversal rules.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 12207:2017","ISO/IEC/IEEE 25010:2023"],"relationships":[{"type":"contrasts_with","record_id":"D50-B71-R005"},{"type":"refines","record_id":"D50-B72-R002"}]} {"record_id":"D50-B72-R005","dataset_id":"D50","topic":"Successful Projects","subtopic":"Decision Learning","concept":"Decision learning eligibility","knowledge_type":"learning_governance","objective":"Determine whether a successful project decision contains sufficient evidence to become reusable decision knowledge.","requirements":["Require decision-time provenance.","Require outcome linkage.","Require applicability conditions.","Require contradiction review.","Require verification state."],"constraints":["A favorable outcome alone does not qualify a decision as a reusable rule."],"input":"Decision record, outcome evidence, applicability context.","output":"Learning eligibility classification.","expected_behavior":"Only decisions meeting configured evidence criteria become reusable knowledge; others remain project-specific observations.","failure_mode":"Anecdotal success is promoted as a general decision rule.","root_cause":"Missing learning-promotion gate.","testing_method":"Evaluate decisions with different evidence quality and outcome strength.","test_input":"Verified decision, weakly attributed decision, and unverified decision.","expected_test_result":"Eligibility classification reflects evidence quality and applicability.","verification_method":"Audit promotion criteria against the decision evidence graph.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["NIST AI Risk Management Framework 1.0","ISO/IEC/IEEE 12207:2017"],"relationships":[{"type":"governs","record_id":"D50-B70-R005"},{"type":"extends","record_id":"D50-B72-R003"}]} {"record_id":"D50-B73-R001","dataset_id":"D50","topic":"Successful Projects","subtopic":"Architecture Learning","concept":"Architecture decision record linkage","knowledge_type":"architecture_evidence","objective":"Connect successful project outcomes with the architectural decisions that materially shaped the resulting system.","requirements":["Identify architecture decision.","Identify affected components.","Record rationale and constraints.","Link relevant outcome evidence."],"constraints":["Architecture decisions must not receive causal credit without supporting evidence."],"input":"Architecture decision records, implementation state, outcome evidence.","output":"Architecture-decision-to-outcome relationship.","expected_behavior":"Future retrieval can identify which architectural choices were associated with the documented outcome and under what conditions.","failure_mode":"Architecture is copied without understanding the constraints under which it succeeded.","root_cause":"Architecture and operational evidence were stored separately without linkage.","testing_method":"Trace a successful outcome backward to material architecture decisions.","test_input":"Architecture graph and success evidence.","expected_test_result":"Material decisions are identifiable with provenance and applicability boundaries.","verification_method":"Cross-reference architecture revisions with deployment and outcome records.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 42010:2022","ISO/IEC/IEEE 12207:2017"],"relationships":[{"type":"requires","record_id":"D50-B72-R002"},{"type":"related_to","record_id":"D50-B73-R002"}]} {"record_id":"D50-B73-R002","dataset_id":"D50","topic":"Successful Projects","subtopic":"Architecture Learning","concept":"Architecture constraint preservation","knowledge_type":"architecture_evidence","objective":"Prevent successful architecture patterns from being reused after their essential constraints have been removed.","requirements":["Record architectural constraints.","Record quality attributes affected.","Record dependency assumptions.","Record deployment assumptions."],"constraints":["Architecture pattern names are insufficient to establish applicability."],"input":"Successful architecture and contextual constraints.","output":"Constraint-preserving architecture knowledge.","expected_behavior":"Reuse evaluation checks the original constraints before treating the architecture as applicable.","failure_mode":"Architecture is transplanted into a context with incompatible constraints.","root_cause":"Pattern abstraction removed necessary context.","testing_method":"Compare source architecture constraints with target architecture requirements.","test_input":"Source architecture and target requirements.","expected_test_result":"Incompatible assumptions are detected before implementation reuse.","verification_method":"Constraint traceability review.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 42010:2022","ISO/IEC/IEEE 25010:2023"],"relationships":[{"type":"refines","record_id":"D50-B70-R002"},{"type":"extends","record_id":"D50-B73-R001"}]} {"record_id":"D50-B73-R003","dataset_id":"D50","topic":"Successful Projects","subtopic":"Architecture Learning","concept":"Architecture trade-off preservation","knowledge_type":"architecture_evidence","objective":"Preserve the trade-offs accepted by a successful architecture rather than representing it as universally optimal.","requirements":["Identify competing quality attributes.","Record accepted compromises.","Record evidence for observed trade-offs.","Record affected operating conditions."],"constraints":["No architecture should be represented as an unconditional optimum from one project outcome."],"input":"Architecture decisions, alternatives, quality attributes, observed outcomes.","output":"Trade-off-aware architecture record.","expected_beha