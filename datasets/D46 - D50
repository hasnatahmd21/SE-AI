{"record_id":"B30-R002","dataset_id":"D50","dataset_version":"1.0","schema_version":"1.0","topic":"Successful Projects","subtopic":"Reproducibility","concept":"A successful project should preserve enough information to reconstruct its validated state","knowledge_type":"REPRODUCIBILITY_RULE","objective":"Capture the operational requirement that future engineers can reconstruct the environment and inputs relevant to validated behavior.","requirements":["Source identity must be preserved","Dependency state must be known","Configuration inputs must be reconstructable","Build or execution procedure must be available","Validation evidence must identify the resulting artifact"],"constraints":["Perfect bit-for-bit reproducibility is not always achievable","External services can limit reconstruction unless their behavior is captured or controlled"],"expected_behavior":"A qualified engineer can recreate a sufficiently equivalent environment to investigate or validate the delivered behavior.","failure_mode":"Source remains available but the environment, configuration, dependencies, or build process cannot be reconstructed.","root_cause":"Reproducibility was considered only at source-code level.","testing_method":"Attempt a clean reconstruction using only the preserved project artifacts and documented inputs.","verification_method":"Compare reconstructed outputs and behavior with the original validated evidence where determinism is expected.","validation_status":"GENERATED","execution_status":"NOT_EXECUTED","provenance":{"type":"validated_operational_engineering_practice","basis":"Established reproducible-build and software archaeology practice","evidence_status":"GENERALIZED_PRACTICE_NOT_PROJECT_SPECIFIC"},"relationships":[{"type":"extends","target":"D50:B22-R003"},{"type":"related_to","target":"D50:B22-R005"}],"confidence":"HIGH"}

