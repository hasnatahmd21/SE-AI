{"record_id":"D49-B71-R004","dataset_id":"D49","dataset_version":"1.0","schema_version":"1.0","batch":"B71","topic":"CI/CD Acceptance Gates","subtopic":"Artifact validation gate","concept":"An artifact acceptance gate must verify that the artifact being promoted is the artifact that passed required validation.","knowledge_type":"VERIFICATION_RULE","language":"English","language_version":"N/A","framework":"N/A","framework_version":"N/A","objective":"Prevent validation evidence from being incorrectly associated with a different artifact.","requirements":["Artifact identity is recorded","Validation evidence references the artifact identity","Promotion uses the validated artifact identity"],"constraints":["Artifact identity must remain stable for the acceptance decision","Equivalent names are insufficient when stronger identity is required"],"prerequisites":["Artifact identifier or digest","Validation evidence","Promotion metadata"],"dependencies":["D49-B73-R001","D49-B20-R005"],"input":{"validated_artifact":"artifact-A","promoted_artifact":"artifact-B","identity_match":false},"output":{"acceptance_status":"FAIL","reason":"artifact_identity_mismatch"},"expected_behavior":"Acceptance fails when promotion references an artifact different from the validated artifact.","correct_example":{"criterion":"PASS only when the promoted artifact identity exactly matches the artifact referenced by required validation evidence."},"incorrect_example":{"criterion":"PASS when artifact names are similar."},"correction":"Use a stable artifact identity appropriate to the system, such as a digest or immutable identifier, rather than a display name.","failure_mode":"Validation evidence is reused for a different artifact.","expected_error":"VALIDATED_ARTIFACT_MISMATCH","security_implication":"Artifact substitution can bypass validation controls.","performance_implication":"Artifact identity checks should add negligible overhead relative to the pipeline workload.","testing_method":"Validate art