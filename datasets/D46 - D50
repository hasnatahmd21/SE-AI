g empirical-method principles"],"relationships":[{"type":"extends","record_id":"D50-B58-R001"},{"type":"related_to","record_id":"D50-B70-R002"}]} {"record_id":"D50-B70-R002","dataset_id":"D50","topic":"Successful Projects","subtopic":"Generalization","concept":"Context-preserving reuse","knowledge_type":"operational_engineering_evidence","objective":"Reuse successful project knowledge while preserving the environmental and architectural conditions that made the result valid.","requirements":["Match technology versions.","Match or map architecture characteristics.","Match relevant workload and constraints.","Verify prerequisites before reuse."],"constraints":["Semantic similarity is insufficient when implementation or version differences alter behavior."],"input":"Source success pattern and candidate target project.","output":"Context compatibility assessment for reuse.","expected_behavior":"Reuse proceeds only when required conditions are satisfied or explicitly adapted and revalidated.","failure_mode":"A pattern is copied into an incompatible context without validation.","root_cause":"Missing compatibility analysis.","testing_method":"Evaluate the pattern against target prerequisites and run representative validation.","test_input":"Source pattern metadata and target project metadata.","expected_test_result":"All mandatory reuse prerequisites are satisfied or adaptation is explicitly required.","verification_method":"Trace each reused assumption to target evidence.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 25010:2023","ISO/IEC/IEEE 12207:2017"],"relationships":[{"type":"specializes","record_id":"D50-B70-R001"},{"type":"compatible_with","record_id":"D50-B64-R003"}]} {"record_id":"D50-B70-R003","dataset_id":"D50","topic":"Successful Projects","subtopic":"Generalization","concept":"Success record closure integrity","knowledge_type":"operational_engineering_evidence","objective":"Ensure project closure preserves all material evidence, exceptions, relationships, and limitations needed for future learning.","requirements":["Verify required evidence fields are populated or explicitly marked unknown.","Preserve linked incidents, changes, repairs, tests, and outcomes.","Preserve unresolved contradictions and limitations.","Record closure status separately from success status."],"constraints":["Closure must not erase unresolved evidence gaps.","Successful completion and evidence completeness are distinct dimensions."],"input":"Project evidence graph and closure criteria.","output":"Integrity-checked closed project record.","expected_behavior":"A closed record remains sufficient for future retrieval, audit, and learning within its evidence boundary.","failure_mode":"Closure removes context required to understand why the project succeeded.","root_cause":"Premature summarization or destructive lifecycle transition.","testing_method":"Run closure validation and reconstruct the project's success chain from the locked record.","test_input":"Candidate project record with all linked evidence.","expected_test_result":"Mandatory relationships and evidence states remain recoverable after closure.","verification_method":"Graph integrity validation plus independent reconstruction.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 12207:2017","ISO/IEC/IEEE 29119"],"relationships":[{"type":"extends","record_id":"D50-B58-R005"},{"type":"requires","record_id":"D50-B69-R004"}]} {"record_id":"D50-B70-R004","dataset_id":"D50","topic":"Successful Projects","subtopic":"Generalization","concept":"Cross-project contradiction preservation","knowledge_type":"contradiction_aware_knowledge","objective":"Preserve conflicting successful-project observations when different contexts produce different valid outcomes.","requirements":["Record both observations.","Record contextual differences.","Avoid forced unification.","Link contradictions explicitly."],"constraints":["Contradiction does not necessarily indicate that one record is false.","Different versions, architectures, workloads, or constraints may explain divergent outcomes."],"input":"Two or more successful-project records with conflicting observations.","output":"Contextualized contradiction set.","expected_behavior":"The knowledge fabric retrieves both observations and the conditions under which each held.","failure_mode":"One observation silently overwrites another.","root_cause":"Overaggressive deduplication or context loss.","testing_method":"Query by concept and verify that materially different successful outcomes remain distinguishable.","test_input":"Conflicting project evidence records.","expected_test_result":"Both records are retrievable with their contextual constraints and contradiction relationship.","verification_method":"Inspect provenance, version, context, and contradiction links.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 12207:2017","ISO/IEC/IEEE 29119"],"relationships":[{"type":"contradicts","record_id":"D50-B70-R002"},{"type":"preserves","record_id":"D50-B52-R005"}]} {"record_id":"D50-B70-R005","dataset_id":"D50","topic":"Successful Projects","subtopic":"Generalization","concept":"Successful-project learning promotion gate","knowledge_type":"learning_governance","objective":"Prevent project-specific success evidence from entering generalized engineering knowledge without sufficient validation.","requirements":["Require provenance.","Require evidence classification.","Require applicability conditions.","Require deduplication.","Require contradiction review.","Require verification status."],"constraints":["Promotion into generalized knowledge must be stricter than storing the original project observation."],"input":"Closed successful-project record and candidate generalized knowledge item.","output":"Promotion decision state without unsupported promotion.","expected_behavior":"Only evidence satisfying the configured promotion criteria can become reusable generalized knowledge.","failure_mode":"A single anecdotal success becomes a system-wide engineering rule.","root_cause":"Missing promotion gate or insufficient evidence threshold.","testing_method":"Submit records with varying provenance, verification, and contextual coverage and verify correct promotion classification.","test_input":"Verified, partially verified, and unverified project evidence.","expected_test_result":"Promotion state reflects the configured evidence requirements and unresolved uncertainty.","verification_method":"Validate provenance, relationships, verification status, contradictions, and applicability before promotion.","security_implication":"Sensitive project evidence must not be promoted into broadly accessible knowledge without authorization and minimization.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 12207:2017","ISO/IEC/IEEE 29119","NIST AI Risk Management Framework 1.0"],"relationships":[{"type":"governs","record_id":"D50-B70-R001"},{"type":"requires","record_id":"D50-B70-R003"},{"type":"extends","record_id":"D50-B58-R005"}]}

{"record_id":"D50-B71-R001","dataset_id":"D50","topic":"Successful Projects","subtopic":"Evidence Quality","concept":"Evidence completeness assessment","knowledge_type":"operational_engineering_evidence","objective":"Determine whether the evidence associated with a successful project is sufficient to support the claims recorded about that success.","requirements":["Identify every material success claim.","Map each claim to supporting evidence.","Identify unsupported or partially supported claims.","Record evidence gaps explicitly."],"constraints":["Completeness is claim-specific and must not be represented as universal completeness.","Missing evidence must remain distinct from negative evidence."],"input":"Project success claims, evidence records, provenance, validation results.","output":"Claim-level evidence completeness assessment.","expected_behavior":"Each material claim is classified as supported, partially supported, unsupported, or unknown according to available evidence.","failure_mode":"Unsupported claims are treated as verified because the project itself was successful.","root_cause":"Evidence and claim states were not independently modeled.","testing_method":"Run evidence-to-claim traceability analysis.","test_input":"Successful project containing verified, partial, and unsupported claims.","expected_test_result":"Each claim receives the correct evidence state.","verification_method":"Independently inspect the evidence chain for each material claim.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 29119 Software Testing","ISO/IEC/IEEE 12207:2017"],"relationships":[{"type":"extends","record_id":"D50-B70-R003"},{"type":"requires","record_id":"D50-B71-R002"}]} {"record_id":"D50-B71-R002","dataset_id":"D50","topic":"Successful Projects","subtopic":"Evidence Quality","concept":"Claim-evidence traceability","knowledge_type":"evidence_traceability","objective":"Maintain an explicit relationship between a project claim and the evidence that supports it.","requirements":["Assign stable identifiers to claims and evidence.","Record evidence relationship type.","Record verification state.","Preserve provenance."],"constraints":["One evidence item may support multiple claims, but each relationship must remain explicit."],"input":"Claim and evidence graph.","output":"Traceable claim-to-evidence relationships.","expected_behavior":"A retrieved claim can be followed to its supporting observations, tests, artifacts, or measurements.","failure_mode":"The system returns a conclusion without recoverable supporting evidence.","root_cause":"Loss of provenance or weak relationship modeling.","testing_method":"Select representative claims and traverse their evidence relationships.","test_input":"Claim with multiple evidence sources.","expected_test_result":"All declared supporting evidence is reachable and attributable.","verification_method":"Graph traversal and provenance validation.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 29119","ISO/IEC/IEEE 12207:2017"],"relationships":[{"type":"supports","record_id":"D50-B71-R001"},{"type":"related_to","record_id":"D50-B63-R004"}]} {"record_id":"D50-B71-R003","dataset_id":"D50","topic":"Successful Projects","subtopic":"Evidence Quality","concept":"Evidence independence classification","knowledge_type":"evidence_quality","objective":"Distinguish independent corroboration from multiple records derived from the same underlying observation.","requirements":["Identify evidence origin.","Identify shared upstream artifacts.","Classify independent versus derived evidence.","Preserve lineage."],"constraints":["Multiple copies or summaries of one observation do not constitute independent corroboration."],"input":"Evidence records and lineage information.","output":"Evidence-independence classification.","expected_behavior":"Correlated evidence is not incorrectly counted as independent confirmation.","failure_mode":"Duplicate derived evidence creates artificial confidence.","root_cause":"Lineage was not preserved during evidence ingestion.","testing_method":"Insert multiple derivatives of one source observation and inspect confidence aggregation.","test_input":"Original observation plus derived summaries.","expected_test_result":"The system recognizes shared provenance and avoids double counting.","verification_method":"Compare provenance graphs and evidence-source identifiers.","validation_status":"REQUIRES_PROJECT_SPECIFIC_EVIDENCE","execution_status":"NOT_EXECUTED","provenance":["ISO/IEC/IEEE 29119","Established evidence-provenance principles"],"relationships":[{"type":"refines","record_id":"D50-B71-R001"},{"type":"related_to","record_id":"D50-B71-R004"}]} {"record_id":"D50-B71-R004","dataset_id":"D50","topic":"Successful Projects","subtopic":"Evidence Quality","concept":"Evidence confidence calibration","knowledge_type":"evidence_quality","objective":"Prevent confidence assigned to successful-project knowledge from exceeding the quality of its supporting evidence.","requirements":["Consider provenance quality.","Consider verification state.","Consider evidence independence.","Consider scope and applicability."],"constraints":["Confidence must not be treated as a substitute for missing evidence.","Numerical confidence values require a defined calibration method."],"input":"Evidence set and confidence policy.","output":"Evidence-bounded confidence classification.","expected_behavior":"Confidence reflects evidence quality and declared uncertainty rather than project success alone.","failure_mode":"A successful outcome causes unsupported confidence inflation.","root_cause":"Success status was incorrectly used as evidence strength.","testing_method":"Evaluate records with different provenance and verification states.","test_input":"Verified, partially verified, and unverified evidence sets.","expected_test_result":"Confiden